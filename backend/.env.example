# Copy to .env and adjust. Never commit the real .env file.

# One of: development, testing, production
ENVIRONMENT=development

APP_NAME="Legal Document & Matter Management System"
API_V1_PREFIX=/api/v1

# Matches the credentials provisioned by the root docker-compose.yml. Used by
# Alembic, `bootstrap-admin`, and the T105 CLIs (`provision-app-role`,
# `reconcile-organizations`) -- the admin/owning Postgres role, unchanged by T105.
DATABASE_URL=postgresql+asyncpg://legal_dms:legal_dms@localhost:5432/legal_dms_dev

# T105/ADR-0021: the live app's own request-serving get_db() connects through this
# distinct, non-owning role instead, so FORCE'd RLS on organizations/users is a real
# backstop. Provisioned by `uv run provision-app-role` (reads POSTGRES_APP_USER/
# POSTGRES_APP_PASSWORD below) -- must be run once, before `alembic upgrade head`.
APP_DATABASE_URL=postgresql+asyncpg://legal_dms_app:legal_dms_app@localhost:5432/legal_dms_dev

# Read directly by `provision-app-role` (not by Settings/pydantic-settings) -- local-
# development-only defaults, mirroring POSTGRES_USER/POSTGRES_PASSWORD below. A
# production deployment must supply the real credential externally.
POSTGRES_APP_USER=legal_dms_app
POSTGRES_APP_PASSWORD=legal_dms_app

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_DIR=logs

# Local filesystem root for LocalFileStorage (see infrastructure/storage/).
STORAGE_ROOT=storage

# Comma-separated list of allowed origins for CORS (the Electron/Vite dev origin(s)).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Feature flags, "name:true,other:false" — a flag not listed defaults to disabled.
FEATURE_FLAGS=

# Required, no code-level default (Stage 3, ADR/0019). Generate your own for local dev, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"` — never reuse this placeholder,
# and never commit a real value.
JWT_SECRET_KEY=changeme-generate-your-own-local-dev-secret

# One of the JWT algorithms PyJWT supports (default HS256 below is fine unless you have a reason).
JWT_ALGORITHM=HS256

# Access token lifetime in minutes; refresh token lifetime in days.
ACCESS_TOKEN_TTL_MINUTES=20
REFRESH_TOKEN_TTL_DAYS=14
